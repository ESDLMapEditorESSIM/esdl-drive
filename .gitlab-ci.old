# ASCII art brought to you by:
# http://patorjk.com/software/taag/#p=display&f=Star%20Wars&t=Type%20Something%20

stages:
  - build


variables:
  TAG: $CI_COMMIT_SHA
  BRANCH: $CI_COMMIT_REF_SLUG
  REGISTRY: ci.tno.nl
  IMAGE_BASE: ci.tno.nl/ESDL/esdl-drive

image: maven:3.9-ibm-semeru-21-jammy

.build-script:
  before_script:
    - apt-get update && apt-get install -y libatomic1 docker.io
    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" $REGISTRY



# ______    __    __   __   __       _______
#|   _  \  |  |  |  | |  | |  |     |       \
#|  |_)  | |  |  |  | |  | |  |     |  .--.  |
#|   _  <  |  |  |  | |  | |  |     |  |  |  |
#|  |_)  | |  `--'  | |  | |  `----.|  '--'  |
#|______/   \______/  |__| |_______||_______/


build-and-push-esdl-drive:
  stage: build
  variables:
    IMAGE: $IMAGE_BASE/esdl-drive
  extends: .build-script
  script:
    -  cd $CI_PROJECT_DIR
    - echo "Commit ref name $COMMIT_REF_NAME"
    - echo "Commit ref name $COMMIT_TAG"
    - mvn -DskipTests clean package
    - mvn liberty:create
    - docker build --build-arg git_commit=$TAG . -f Dockerfile -t $IMAGE:$COMMIT_TAG -t $IMAGE:$BRANCH
    - docker push $IMAGE:$TAG
    - docker push $IMAGE:$BRANCH


